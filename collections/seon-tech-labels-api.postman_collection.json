  "info": {
    "_postman_id": "d2f1ad76-5c1c-4a19-8eaa-73059308c701",
    "name": "SEON REST AML Labels API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "SEON's fraud prevention and anti-money-laundering REST API. Combines digital-footprint analysis, device fingerprinting, and machine-learning risk scoring to return real-time fraud scores and enriched intelligence from an email address, phone number, IP address, or full transaction payload, plus AML screening and transaction labeling. All requests authenticate with an X-API-KEY header and are case-sensitive.\n\nContact Support:\n Name: SEON Support\n Email: support@seon.io",
      "type": "text/plain"
    }
